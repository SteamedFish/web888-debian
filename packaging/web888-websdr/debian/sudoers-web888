# Shipped by the web888-websdr deb (postinst validates with visudo -c).
# The unprivileged websdr service (user web888) may run ONLY these three
# root-owned helper scripts — the network drop-in installer, the USB-WiFi
# config installer, and the power action wrapper — and nothing else.
# NOPASSWD: the service has no tty.
# Helper scripts live in /usr/lib/web888/root-helpers/ (root-owned, not
# writable by web888) and validate all staged input; never eval.
web888 ALL=(root) NOPASSWD: /usr/lib/web888/root-helpers/web888-netconfig, /usr/lib/web888/root-helpers/web888-wificonfig, /usr/lib/web888/root-helpers/web888-poweroff
