#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# zz-web888-zimage — point the /boot/zImage symlink at the kernel deb's image.
#
# Shipped by web888-boot; invoked from the linux-image postinst through
# run-parts /etc/kernel/postinst.d with:
#   $1 = kernel release (e.g. 6.12.100-web888)
#   $2 = installed image path (/boot/vmlinuz-<krel>)
#
# boot.scr ext4-loads /boot/zImage from the rootfs (fallback
# /boot/zImage.prev); both are symlinks managed here. The previous target
# becomes zImage.prev, so a bad kernel update stays recoverable. Symlinks
# only — no copies, no mount requirements, so the hook also runs correctly
# inside the image-build chroot (that is where the shipped link is made).
set -e

krel="$1"
image="$2"

[ -f "$image" ] || exit 0

# Rotate: the current target becomes the fallback, unless it IS the image
# being (re)installed.
cur=""
[ -L /boot/zImage ] && cur=$(readlink /boot/zImage)
if [ -n "$cur" ] && [ "$cur" != "vmlinuz-$krel" ]; then
    ln -sfn "$cur" /boot/zImage.prev
fi
ln -sfn "vmlinuz-$krel" /boot/zImage
echo "zz-web888-zimage: /boot/zImage -> vmlinuz-$krel (fallback: ${cur:-none})"