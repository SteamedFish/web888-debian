# kernel-web888-6.12-lean.fragment — Web-888 kernel size/speed trim
#
# GENERATED by scripts/gen-kernel-lean-fragment.py — do not hand-edit.
# Regenerate against a FULL config: KERNEL_LEAN=0 scripts/build-kernel-6.12.sh
#
# Strategy (mirrors Armbian linux-zynq-legacy): keep the Zynq's own IP
# drivers and full USB peripheral breadth (serial/net/storage/UAS/audio/
# BT/WiFi/gadget/UVC), drop everything the board can never host: PCI,
# GPU/DRM/FB, DVB/analog/radio/platform media, ASoC, platform IIO,
# ATA/NVMe/Infiniband/MD/Xen/target/coresight, exotic filesystems and
# network protocols. This also fixes the RTL-SDR/DVB conflict (DVB
# drivers no longer grab RTL2832 dongles).

CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y

# --- bus/platform/display/storage/protocol masters ---
# [no PCI slot on Zynq-7010; cascades to NVMe, AHCI-PCI, PCI WiFi/NIC/...]
# CONFIG_PCI is not set
# [no virtualization target; QEMU smoke test uses SD + cadence GEM]
# CONFIG_VIRTIO is not set
# [no Xen on a 512 MB SDR]
# CONFIG_XEN is not set
# [FPGA is programmed via /dev/xdevcfg (XILINX_DEVCFG), not fpga-mgr]
# CONFIG_FPGA_MGR is not set
# [no display output; kills GPU/display ecosystem incl. PL330 DMA test...]
# CONFIG_DRM is not set
# [no framebuffer console; serial/SSH only]
# CONFIG_FB is not set
# [no SATA/PATA]
# CONFIG_ATA is not set
# [no RAID/LVM-on-kernel; 512 MB ARM board]
# CONFIG_MD is not set
# [no QSPI/NAND flash node in web888.dts (dropped when adding I2C EEPR...]
# CONFIG_MTD is not set
# [no RDMA]
# CONFIG_INFINIBAND is not set
# [no iSCSI target]
# CONFIG_TARGET_CORE is not set
# [no ARM coresight debug tracing]
# CONFIG_CORESIGHT is not set
# [no braille console]
# CONFIG_ACCESSIBILITY is not set
# [no 1-wire devices]
# CONFIG_W1 is not set
# [no NFC]
# CONFIG_NFC is not set
# [no HDMI CEC]
# CONFIG_MEDIA_CEC_SUPPORT is not set
# [no analog TV]
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# [no DVB tuners; RTL-SDR users prefer direct libusb (no blacklist nee...]
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# [no AM/FM radio tuners]
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# [no V4L2 SDR receivers; RTL-SDR users prefer direct libusb]
# CONFIG_MEDIA_SDR_SUPPORT is not set
# [no platform video capture (imx/rockchip/sunxi/bcm2835)]
# CONFIG_MEDIA_PLATFORM_SUPPORT is not set
# [no vivid test drivers]
# CONFIG_MEDIA_TEST_SUPPORT is not set
# [no infrared remote]
# CONFIG_RC_CORE is not set
# [no ASoC codecs (ADI/HDMI audio IP unused in web888.dts)]
# CONFIG_SND_SOC is not set
# [no legacy ISA/platform sound drivers]
# CONFIG_SND_DRIVERS is not set
# [no SoundWire audio bus]
# CONFIG_SOUNDWIRE is not set
# [no ATM networking]
# CONFIG_ATM is not set
# [no X.25 (AX.25 ham radio stays)]
# CONFIG_X25 is not set
# [X.25 link layer]
# CONFIG_LAPB is not set
# [no 802.15.4 radios; cascades to 6lowpan]
# CONFIG_IEEE802154 is not set
# [no RDS sockets]
# CONFIG_RDS is not set
# [no IBM SMC]
# CONFIG_SMC is not set
# [no Nokia phonet]
# CONFIG_PHONET is not set
# [no CAIF]
# CONFIG_CAIF is not set
# [Qualcomm IPC router (PCI 5G modems only, dead with PCI)]
# CONFIG_QRTR is not set
# [Qualcomm MHI (PCI modems only)]
# CONFIG_MHI_BUS is not set
# [no switch fabric on a single-NIC board]
# CONFIG_NET_DSA is not set
# [no packet generator]
# CONFIG_NET_PKTGEN is not set
# [no drop monitor]
# CONFIG_NET_DROP_MONITOR is not set
# [no AppleTalk]
# CONFIG_ATALK is not set
# [no IPX/SPX]
# CONFIG_IPX is not set
# [no ARCNET]
# CONFIG_ARCNET is not set
# [no ultra-wideband]
# CONFIG_UWB is not set
# [no WiMAX]
# CONFIG_WIMAX is not set
# [no frame relay]
# CONFIG_FRAME_RELAY is not set
# [no sync-serial HDLC]
# CONFIG_HDLC is not set
# [no USB3 xHCI on Zynq-7010]
# CONFIG_USB_XHCI_HCD is not set
# [no DWC3 controller (Zynq USB is chipidea)]
# CONFIG_USB_DWC3 is not set
# [no DWC2 controller (Zynq USB is chipidea)]
# CONFIG_USB_DWC2 is not set
# [skip module signing (Debian enables MODULE_SIG_ALL)]
# CONFIG_MODULE_SIG is not set
# [selects MODULE_SIG; no secure boot on this board]
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
# [module appraisal needs signing; off with MODULE_SIG]
# CONFIG_IMA_APPRAISE_MODSIG is not set
# [selects VIRTIO; no virtio]
# CONFIG_VIRTIO_FS is not set
# [selects VIRTIO; =y in Debian base so dir rules miss it]
# CONFIG_VIRTIO_CONSOLE is not set
# [selected by VIRTIO]
# CONFIG_VIRTIO_ANCHOR is not set
# [no remote processors on Zynq-7010]
# CONFIG_REMOTEPROC is not set
# [no remote processors; RPMSG_VIRTIO selects VIRTIO]
# CONFIG_RPMSG is not set

