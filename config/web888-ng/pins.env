# config/web888-ng/pins.env — pinned upstream inputs for the optional
# web888-web888d / web888-ng-bitstream packages (Phase 2 lane A).
#
# All downloads are verified against the SHA256 values recorded here before
# use; the build scripts refuse to continue on a mismatch. Bump versions only
# together with a matching hash taken from the upstream release.
#
# Tag -> commit mapping (verified 2026-11-01 via the GitHub API):
#   jeskko/web888-ng    tag v0.6.0 (annotated, 242bf1fab3434070d1783c56b6e6949011e4ae94)
#                       -> commit 48e9914aac80e3f20c39838fe9b33193b6b3fb36
#   jeskko/web888-ng-hw tag v0.3.0 (annotated, 8b7ab5061ad6be5cd24322dd8912b6551e25350a)
#                       -> commit 767030740a2fdecfebdd383efd23330e6455ff1b

# --- web888-ng: daemon + web UI source -------------------------------------
WEB888_NG_VERSION=0.8.0
WEB888_NG_COMMIT=9a853efbbfcf93e36a18c5f8c591cc377e49bebd
WEB888_NG_TARBALL=web888-ng-v0.8.0.tar.gz
WEB888_NG_TARBALL_URL=https://codeload.github.com/jeskko/web888-ng/tar.gz/refs/tags/v0.8.0
WEB888_NG_SHA256=42af9bc7ef055dd5451d4d4e7c47e4c56d488790c4737f2785270c79b5edc660

# --- web888-ng-hw: open FPGA bitstreams + source (provenance) --------------
