+                            scallz("resolv staging fopen", (rfp = fopen(DIR_STATE "/netconfig/resolv.conf", "w")));
+                            if (!dns1_err) fprintf(rfp, "nameserver %s\n", dns1);
+                            if (!dns2_err) fprintf(rfp, "nameserver %s\n", dns2);
+                            fclose(rfp);
+                            int nc_status = system("sudo -n /usr/lib/web888/root-helpers/web888-netconfig dns");
+                            clprintf(conn, "dns: netconfig helper status=%d\n", nc_status);
                         }
                     }
 
@@ -700,9 +744,18 @@ void c2s_admin(void* param) {
             i = strcmp(cmd, "SET use_DHCP");
             if (i == 0) {
                 clprintf(conn, "eth0: USE DHCP\n");
-                system("rm /etc/network/interfaces");
