diff --git a/net/update.cpp b/net/update.cpp
index 23f1cd5..0756ef0 100644
--- a/net/update.cpp
+++ b/net/update.cpp
@@ -646,6 +646,13 @@ void update_init()
 
 void update_start()
 {
+    // web888 Debian: updates are delivered as Debian packages via apt. The stock
+    // updater would unzip an upstream release into /media/mmcblk0p1 (a plain
+    // directory on our rootfs, not the FAT partition) and then reboot — disable it.
+    if (debian_maj != 0) {
+        lprintf("UPDATE: Debian-managed system, built-in updater disabled\n");
+        return;
+    }
     next_update_check = timer_sec() + update_check_interval_s;
     update_pending = true;
     check_for_update(WAIT_UNTIL_NO_USERS, NULL);
