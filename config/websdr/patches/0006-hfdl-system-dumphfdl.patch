From: web888-debian step3
Subject: HFDL: run system dumphfdl from /usr/bin (was FAT partition)

The vendored dumphfdl built from the externals/ submodule links against
library versions that no longer match the Debian trixie runtime, so it
cannot run. The system dumphfdl package (a hard Depends) installs a
working binary at /usr/bin/dumphfdl; launch that instead.

--- a/extensions/HFDL/HFDL.cpp
+++ b/extensions/HFDL/HFDL.cpp
@@ -179,8 +179,8 @@
 
         sprintf(sample_rate_str, "%d", snd_rate);
 
-        execlp("/media/mmcblk0p1/dumphfdl",     
-            "/media/mmcblk0p1/dumphfdl", "--system-table", DIR_SAMPLES "/HFDL_systable.conf",
+        execlp("/usr/bin/dumphfdl",
+            "/usr/bin/dumphfdl", "--system-table", DIR_SAMPLES "/HFDL_systable.conf",
             "--iq-file", "-",
         
             #ifdef SAMPLES_CF32
