+        const char* password = admcfg_string("wifi_password", NULL, CFG_OPTIONAL);
+        if (ssid != NULL) {
+            // staged values are URI-encoded in admcfg (w3_string_set_cfg_cb)
+            system("mkdir -p " DIR_STATE "/wificonfig");
+            FILE* fp = fopen(DIR_STATE "/wificonfig/wifi.conf", "w");
