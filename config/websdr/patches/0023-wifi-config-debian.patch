+    // Debian: apply the admin console's USB-WiFi settings via the
+    // web888-wificonfig root helper. Only at init — admin-page edits carry
+    // the w3-restart class, so they take effect on the restart that the
+    // admin page itself triggers. Gated on wifi_configured because admcfg
+    // ships wifi_* defaults: without the gate every first boot would
+    // silently reconfigure the system network.
+    if (called_at_init && admcfg_bool("wifi_configured", NULL, CFG_OPTIONAL) == 1) {
+        int wifi_mode = admcfg_int("wifi_mode", NULL, CFG_OPTIONAL);
