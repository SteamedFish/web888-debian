+// USB WIFI widgets: mirror the wrapped callback, and on a real user edit
+// (not the initial page-load pass) mark adm.wifi_configured so the server
+// knows the admin actually set WiFi params and may apply them at restart.
+function wifi_mode_cb(path, val, first)
+{
+	admin_int_cb(path, val, first);
+	var save = isArg(first)? (first? false : true) : true;
+	if (save) ext_set_cfg_param('adm.wifi_configured', true, true);
+}
+
+function wifi_string_cb(path, val, first)
+{
+	w3_string_set_cfg_cb(path, val, first);
+	var save = isArg(first)? (first? false : true) : true;
+	if (save) ext_set_cfg_param('adm.wifi_configured', true, true);
+}
