 /*
+ * set_pll_assignment(enum si5351_clock clk, enum si5351_pll pll)
+ *
+ * Software-side counterpart of set_ms_source(): updates pll_assignment[]
+ * only, WITHOUT touching the CLKx_CTRL mux register. Needed by the airband
+ * path on web-888 (see zynq/peri.cpp) to program PLLB while the clock mux
+ * is still sourced from the locked PLLA.
+ */
+void Si5351::set_pll_assignment(enum si5351_clock clk, enum si5351_pll pll) {
+    pll_assignment[(uint8_t)clk] = pll;
+}
