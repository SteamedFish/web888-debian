+	try {
+      // requires that rv == null means item not in storage
+      // not that the value stored is null
+	   rv = localStorage.getItem(k);
+	   if (rv == null && isArg(def))
+	      rv = def;
+	} catch(ex) {
+      console.log('$>kiwi_storeRead CATCH: '+ k);
+      console.log('$>kiwi_storeRead CATCH: '+ ex);
