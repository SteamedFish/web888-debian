+char* kiwi_fmt_usec(double usec) {
+    usec /= 1e3;            // mmm.uuu ms
+    const char* dunit = "ms";
+    if (usec >= 3600000) {  // >= 60 min
+        usec /= 3600000;    // _hh.fff hr
+        dunit = "Hr";
+    } else
+    if (usec >= 60000) {    // >= 60 secs
+        usec /= 60000;      // _mm.fff min
+        dunit = "Mn";
+    } else
+    if (usec >= 1000) {     // >= 1 sec
+        usec /= 1000;       // _ss.fff sec
+        dunit = "s";
+    }
+    char* rv;
+    asprintf(&rv, "%7.3f%-2s", usec, dunit);
+    return rv;
+}
