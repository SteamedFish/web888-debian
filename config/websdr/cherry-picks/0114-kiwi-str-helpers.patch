+bool kiwi_nonEmptyStrRemNL(char* s) {
+    if (s == NULL) return false;
+    int sl = strlen(s);
+    if (sl != 0 && s[sl-1] == '\n') { s[sl-1] = '\0'; sl--; }
+    return (sl != 0);
+}
