+// Ported from KiwiSDR 6f21031 "IP address parsing security improvements".
+// Adapted for Web-888: const char* signatures, no kiwi_emptyStr, no ansi.h colors.
+// Be very strict about the content of inet4_str (reject trailing junk / bad octets).
+u4_t inet4_d2h_strict(const char* inet4_str, bool* error, u1_t* ap, u1_t* bp, u1_t* cp, u1_t* dp, bool debug) {
+    if (error != NULL) *error = false;
+    int n, sl;
+    u4_t a, b, c, d, nm = 32;
+
+    if (inet4_str == NULL || inet4_str[0] == 0)
+        goto err;
+
+    sl = (int) strlen(inet4_str);
+    int consumed; // guard against any junk at the end
+    n = sscanf(inet4_str, "::ffff:%d.%d.%d.%d%n", &a, &b, &c, &d, &consumed); // IPv4-mapped address
+    if (n != 4 || consumed != sl) {
+        if (inet4_str[0] != '+' && !(inet4_str[0] >= '0' && inet4_str[0] <= '9')) { // '+' is whitelist override
+            goto err;
+        }
+        n = sscanf(inet4_str, "%d.%d.%d.%d/%d%n", &a, &b, &c, &d, &nm, &consumed);
+        if (n != 5 || consumed != sl) {
+            n = sscanf(inet4_str, "%d.%d.%d.%d%n", &a, &b, &c, &d, &consumed);
+            if (n != 4 || consumed != sl) {
+                goto err; // IPv6 or invalid
+            }
+            nm = 32;
+        }
+    }
+    if (a < 0 || a > 255 || b < 0 || b > 255 || c < 0 || c > 255 || d < 0 || d > 255 || (int) nm < 0 || (int) nm > 32)
+        goto err;
+    if (debug) printf("inet4_d2h_strict: accepted \"%s\"\n", inet4_str);
+
+    if (ap) *ap = a & 255;
+    if (bp) *bp = b & 255;
+    if (cp) *cp = c & 255;
+    if (dp) *dp = d & 255;
+    return INET4_DTOH(a, b, c, d);
+
+err:
+    printf("WARNING inet4_d2h_strict: BAD inet4_str \"%s\"\n", inet4_str ? inet4_str : "(null)");
+    if (error != NULL) *error = true;
+    return 0;
+}
+
+// Be very strict about the content of inet6_str.
+bool is_valid_ipv6_strict(const char* inet6_str) {
+    if (inet6_str == NULL || inet6_str[0] == 0) return false;
+
+    // glibc inet_pton() considers the entire string, so junk after a valid ip fails.
+    // Double-check via scanf for whitespace + trailing junk.
+    struct in6_addr addr;
+    if (inet_pton(AF_INET6, inet6_str, &addr) != 1)
+        return false;
+
+    int sl = (int) strlen(inet6_str);
+    int consumed = 0;
+    if (sscanf(inet6_str, "%*s%n", &consumed) != 0 || consumed != sl) {
+        printf("WARNING is_valid_ipv6_strict: BAD inet6_str \"%s\"\n", inet6_str);
+        return false;
+    }
+    return true;
+}
