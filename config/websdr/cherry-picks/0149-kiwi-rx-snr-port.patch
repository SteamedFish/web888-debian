+        for (int ch = 0; ch < rx_chans; ch++) {
+            if (rx_chan == SM_RX_CHAN_ALL || rx_chan == ch) {
+                conn_t* c = rx_channels[ch].conn;
+                if (!c) continue;
+                if (debug) printf("send_msg: RX%d(%p) <%s>\n", ch, c, s);
+                send_msg_buf(c, s, strlen(s));
+                rv = 0;
+            }
+        }
+    }
+
+    kiwi_asfree(s, "snd_send_msg");
+    return rv;
+}
