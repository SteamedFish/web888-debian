+// Web-888 0150: re-measure SNR after antenna change (adapted from KiwiSDR "SET antsw_snr").
+// Upstream re-arms a 5s deadline via TWF_NEW_DEADLINE_SEC, which the fork coroutines lack;
+// wake the SNR task immediately instead (same mechanism as admin "Measure SNR now").
+static void ant_switch_snr_remeas()
+{
+    if (cfg_bool("snr_meas_ant_sw", NULL, CFG_OPTIONAL) && SNR_meas_tid) {
+        TaskWakeupF(SNR_meas_tid, TWF_CANCEL_DEADLINE);
+    }
+}
+
 void ant_switch_setantenna(int antenna)
 {
     if (antenna == 0) {
@@ -48,6 +60,7 @@ void ant_switch_setantenna(int antenna)
     }
 
     fpga_set_antenna(antenna_current);
+    ant_switch_snr_remeas();
     return;
 }
 
@@ -68,6 +81,7 @@ void ant_switch_toggleantenna(int antenna)
     }
 
     fpga_set_antenna(antenna_current);
+    ant_switch_snr_remeas();
 
     return;
 }
