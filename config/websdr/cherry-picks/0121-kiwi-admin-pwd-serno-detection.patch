diff --git a/support/security.cpp b/support/security.cpp
--- a/support/security.cpp
+++ b/support/security.cpp
@@ -57,6 +57,36 @@
 }
 
 
+// Detect the unsafe condition where the admin password is the same as the
+// receiver serial number. Ported from KiwiSDR commit 37f65b4b ("important
+// security fixes/improvements") and adapted for Web-888:
+//   - the receiver serial number lives in net.serno (not kiwi.serno);
+//   - the rev_auto/rev_host config keys used by the upstream host-comparison
+//     branch are absent on Web-888, so only the admin-password-vs-serial
+//     comparison is performed (matching the simplified upstream logic);
+//   - on a positive match kiwi.admin_advisory is set and the function returns
+//     true so callers can warn the operator to change the password.
+bool admin_pwd_unsafe()
+{
+    kiwi.admin_advisory = false;
+    if (cfg_int("sdr_hu_dom_sel", NULL, CFG_REQUIRED) != DOM_SEL_REV) return false;
+
+    char* serno_s;
+    asprintf(&serno_s, "%d", net.serno);
+    const char* apw = admcfg_string("admin_password", NULL, CFG_OPTIONAL);
+
+    if (apw != NULL && strcmp(apw, serno_s) == 0) {
+        kiwi.admin_advisory = true;
+    }
+
+    //printf("admin_pwd_unsafe serno=%d apw=<%s> advisory=%d\n",
+    //    net.serno, apw, kiwi.admin_advisory);
+    admcfg_string_free(apw);
+    free(serno_s);
+    return kiwi.admin_advisory;
+}
+
+
 // see: man 3 crypt
 
 #define HASH_FUNC_SHA_512 "6"

